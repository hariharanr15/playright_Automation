{
  "name": "construction-delivery-pom-tests",
  "version": "1.0.0",
  "description": "Construction Delivery Playwright automation suite.",
  "scripts": {
    "setup": "npm install && npx playwright install",
    "setup:browsers": "npx playwright install",
    "test": "playwright test",
    "test:chrome": "playwright test --project=\"Google Chrome\" --headed",
    "test:smoke": "playwright test tests/smoke --project=\"Google Chrome\" --headed --workers=1",
    "test:regression": "node scripts/run-regression-flow.js",
    "test:regression:headless": "node scripts/run-regression-flow.js --headless",
    "test:full-regression:chrome": "node scripts/run-test-suites.js --suite regression",
    "test:suites": "node scripts/run-test-suites.js",
    "test:suites:no-open": "node scripts/run-test-suites.js --no-open",
    "test:suite": "node scripts/run-test-suites.js",
    "test:suite:headless": "node scripts/run-test-suites.js --headless",
    "test:module:smoke": "node scripts/run-test-suites.js --suite smoke --module",
    "test:module:regression": "node scripts/run-test-suites.js --suite regression --module",
    "test:booking-list:regression:chrome": "set PLAYWRIGHT_SLOW_MO_MS=0&& set BOOKING_LIST_ACTION_WAIT_MS=500&& set BOOKING_LIST_HOVER_WAIT_MS=700&& set BOOKING_LIST_STEP_WAIT_MS=250&& node scripts/run-test-suites.js --suite regression --module booking-list",
    "test:booking-list:regression:chrome:headless": "set PLAYWRIGHT_SLOW_MO_MS=0&& set BOOKING_LIST_ACTION_WAIT_MS=500&& set BOOKING_LIST_HOVER_WAIT_MS=700&& set BOOKING_LIST_STEP_WAIT_MS=250&& node scripts/run-test-suites.js --suite regression --module booking-list --headless --no-open",
    "test:project-management:regression": "node scripts/run-test-suites.js --suite regression --module project-management",
    "test:project-management:regression:headless": "node scripts/run-test-suites.js --suite regression --module project-management --headless",
    "test:modules": "node scripts/run-test-suites.js --list-modules",
    "test:complete": "node scripts/run-complete-automation-flow.js",
    "test:complete:safe": "node scripts/run-complete-automation-flow.js --safe-only",
    "test:complete:headed": "node scripts/run-complete-automation-flow.js --headed --open",
    "cucumber": "cucumber-js",
    "cucumber:smoke": "node scripts/run-cucumber-suite.js --suite smoke",
    "cucumber:smoke:headless": "node scripts/run-cucumber-suite.js --suite smoke --headless",
    "cucumber:regression": "node scripts/run-cucumber-suite.js --suite regression",
    "cucumber:regression:headless": "node scripts/run-cucumber-suite.js --suite regression --headless",
    "cucumber:negative": "node scripts/run-cucumber-suite.js --suite regression --tags \"@negative\"",
    "cucumber:positive": "node scripts/run-cucumber-suite.js --suite regression --tags \"@positive\"",
    "cucumber:failed": "node scripts/run-cucumber-suite.js --failed",
    "cucumber:catalog": "cucumber-js --profile applicationCatalog",
    "cucumber:construction": "cucumber-js --profile constructionDelivery",
    "cucumber:construction:headless": "set CUCUMBER_HEADLESS=true&& cucumber-js --profile constructionDelivery",
    "cucumber:project-management": "cucumber-js --profile projectManagement",
    "cucumber:project-management:headless": "set CUCUMBER_HEADLESS=true&& cucumber-js --profile projectManagement",
    "cucumber:user-management": "cucumber-js --profile userManagement",
    "cucumber:user-management:headless": "set CUCUMBER_HEADLESS=true&& cucumber-js --profile userManagement",
    "automate:booking-list-exports": "node scripts/download-booking-list-exports.js",
    "automate:booking-list-exports:headless": "node scripts/download-booking-list-exports.js --headless",
    "automate:user-management": "node scripts/run-user-management-functional-flow.js",
    "automate:user-management:headless": "node scripts/run-user-management-functional-flow.js --headless",
    "automate:user-management:three-users": "node scripts/run-user-management-functional-flow.js --users=3",
    "automate:user-management:three-users:headless": "node scripts/run-user-management-functional-flow.js --users=3 --headless",
    "automate:analytics": "node scripts/run-analytics-flow.js",
    "automate:analytics:headless": "node scripts/run-analytics-flow.js --headless",
    "automate:environment-reports": "node scripts/run-environment-reports-flow.js",
    "automate:environment-reports:headless": "node scripts/run-environment-reports-flow.js --headless",
    "automate:project-settings": "node scripts/run-project-settings-flow.js",
    "automate:project-settings:headless": "node scripts/run-project-settings-flow.js --headless",
    "automate:project-settings-chrome": "node scripts/run-project-settings-chrome-automation.js",
    "automate:project-settings-chrome:headless": "node scripts/run-project-settings-chrome-automation.js --headless",
    "automate:project-management": "node scripts/run-project-management-flow.js",
    "automate:project-management:headless": "node scripts/run-project-management-flow.js --headless",
    "automate:equipment-management": "node scripts/run-equipment-management-flow.js",
    "automate:equipment-management:headless": "node scripts/run-equipment-management-flow.js --headless",
    "automate:updated-equipment-list": "node \"scripts/Updated- Equi. LIst -Equipment management.js\"",
    "automate:updated-equipment-list:headless": "node \"scripts/Updated- Equi. LIst -Equipment management.js\" --headless",
    "automate:my-account": "node scripts/run-my-account-flow.js",
    "automate:my-account:headless": "node scripts/run-my-account-flow.js --headless",
    "automate:notification-chrome": "node scripts/run-notification-chrome-automation.js",
    "automate:notification-chrome:headless": "node scripts/run-notification-chrome-automation.js --headless",
    "automate:notification-functional": "node scripts/run-notification-status-matrix-flow.js --functional",
    "automate:notification-functional:headless": "node scripts/run-notification-status-matrix-flow.js --functional --headless",
    "automate:notification-status-matrix": "node scripts/run-notification-status-matrix-flow.js",
    "automate:notification-status-matrix:headless": "node scripts/run-notification-status-matrix-flow.js --headless",
    "automate:my-organization": "node scripts/run-my-organization-flow.js",
    "automate:my-organization:headless": "node scripts/run-my-organization-flow.js --headless",
    "automate:project-management-flow": "node scripts/run-project-management-flow.js",
    "automate:project-management-chrome": "node scripts/run-project-management-chrome-automation.js",
    "automate:project-management-chrome:headless": "node scripts/run-project-management-chrome-automation.js --headless",
    "automate:project-management-safe-chrome": "npm run cucumber:project-management",
    "automate:project-management-safe-chrome:headless": "npm run cucumber:project-management:headless",
    "automate:booking-creations": "node run-full-application.js --fast --booking-creation-only --no-open",
    "automate:booking-creations:headless": "node run-full-application.js --fast --booking-creation-only --headless --no-open",
    "automate:booking-list-page": "node run-full-application.js --single-browser --turbo --booking-list-page-only --continue-on-failure --no-open",
    "automate:dynamic-booking-approval": "node run-full-application.js --fast --booking-creation-only --approval-matrix --continue-on-failure --no-open",
    "automate:dynamic-booking-approval:headless": "node run-full-application.js --fast --booking-creation-only --approval-matrix --continue-on-failure --headless --no-open",
    "automate:role-navigation": "node scripts/run-role-navigation-flow.js --no-open",
    "automate:role-navigation:headless": "node scripts/run-role-navigation-flow.js --headless --no-open",
    "automate:full-application": "node run-full-application.js --fast --continue-on-failure",
    "automate:full-application:headless": "node run-full-application.js --fast --headless --continue-on-failure",
    "automate:full-application:single-browser": "node run-full-application.js --single-browser --turbo --continue-on-failure --no-open",
    "automate:calendar": "node pages/booking/calendar.booking.page.js --complete",
    "automate:calendar:headless": "node pages/booking/calendar.booking.page.js --complete --headless",
    "automate:calendar:calendar-only": "node pages/booking/calendar.booking.page.js --calendar-only",
    "automate:calendar:resource-only": "node pages/booking/calendar.booking.page.js --resource-only",
    "automate:calendar:access-points-only": "node pages/booking/calendar.booking.page.js --access-points-only",
    "automate:calendar:smoke": "node pages/booking/calendar.booking.page.js --smoke",
    "automate:calendar:regression": "node pages/booking/calendar.booking.page.js --regression",
    "test:calendar:smoke": "playwright test --grep \"@calendar.*@smoke\" --project=\"Google Chrome\" --headed --workers=1",
    "test:calendar:regression": "playwright test --grep \"@calendar.*@regression\" --project=\"Google Chrome\" --headed --workers=1",
    "test:functional:headless": "playwright test tests/smoke tests/regression --project=\"Google Chrome\" --workers=1"
  },
  "keywords": [
    "playwright",
    "booking",
    "automation"
  ],
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.59.1",
    "xlsx": "^0.18.5"
  }
}
