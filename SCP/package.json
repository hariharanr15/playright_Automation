    "test:scp:full:headed": "node scripts/run-scp-full-regression.js --execute --headed",
    "test:scp:full:normal": "node scripts/run-scp-full-regression.js --execute --headed --normal",
    "test:scp:full:fast": "node scripts/run-scp-full-regression.js --execute --fast",
    "test:scp:full:demo": "node scripts/run-scp-full-regression.js --execute --demo",
