{
  "name": "scp-playwright-pom-tests",
  "version": "1.0.0",
  "description": "SCP Playwright automation suite using Page Object Model.",
  "scripts": {
    "setup": "npm install && npx playwright install",
    "setup:browsers": "npx playwright install",
    "test": "playwright test",
    "test:chrome": "playwright test --project=\"Google Chrome\"",
    "test:headed": "playwright test --project=\"Google Chrome\" --headed",
    "test:smoke": "playwright test tests/smoke --project=\"Google Chrome\" --workers=1",
    "test:regression": "playwright test tests/regression --project=\"Google Chrome\" --workers=1",
    "test:management-dashboard": "playwright test tests/smoke/scp-management-dashboard.spec.js --project=\"Google Chrome\" --workers=1",
    "test:management-dashboard:headed": "playwright test tests/smoke/scp-management-dashboard.spec.js --project=\"Google Chrome\" --headed --workers=1",
    "test:first-delivery-config": "playwright test tests/regression/scp-first-delivery-inspection-config.spec.js --project=\"Google Chrome\" --workers=1",
    "test:first-delivery-config:headed": "playwright test tests/regression/scp-first-delivery-inspection-config.spec.js --project=\"Google Chrome\" --headed --workers=1",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/playwright-html"
  },
  "keywords": [
    "playwright",
    "pom",
    "scp",
    "automation"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
