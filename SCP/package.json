    "test:scp:regression:chrome:demo": "node scripts/run-scp-full-regression.js --execute --demo",
    "test:application": "node scripts/run-scp-full-regression.js --execute",
    "test:application:headed": "node scripts/run-scp-full-regression.js --execute --headed",
    "test:application:demo": "node scripts/run-scp-full-regression.js --execute --demo",
