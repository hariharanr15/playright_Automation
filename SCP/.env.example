# SCP application URLs.
SCP_BASE_URL=https://stg-supplychain-app.voyagecontrol.com
SCP_LOGIN_URL=https://stg-login.voyagecontrol.com/api/sso/users/login/
SCP_MANAGEMENT_DASHBOARD_URL=https://stg-supplychain-app.voyagecontrol.com/management-dashboard

# Login credentials. Keep real values in .env, not in source control.
SCP_USERNAME=
SCP_PASSWORD=

# Optional role-specific accounts. Admin falls back to SCP_USERNAME/SCP_PASSWORD.
SCP_DEFAULT_ROLE=admin
SCP_ADMIN_USERNAME=
SCP_ADMIN_PASSWORD=
SCP_SUBCONTRACTOR_USERNAME=
SCP_SUBCONTRACTOR_PASSWORD=
SCP_SUPPLIER_USERNAME=
SCP_SUPPLIER_PASSWORD=

# Names used in the SCP navigation flow.
SCP_PLATFORM_NAME=Supply Chain Planner
SCP_PLATFORM_CARD_NAME=Supply Chain Planner Supply
SCP_PROJECT_NAME=NRVC_Hall
SCP_PROJECT_MANAGEMENT_NAME=Project Management
SCP_FIRST_DELIVERY_INSPECTION_CONFIG_NAME=First Delivery Inspection Config
SCP_FIRST_DELIVERY_INSPECTION_CONFIG_URL=https://stg-supplychain-app.voyagecontrol.com/first-delivery-inspection-config
SCP_FIRST_DELIVERY_INSPECTIONS_URL=https://stg-supplychain-app.voyagecontrol.com/first-delivery-inspections
SCP_YOPMAIL_URL=https://yopmail.com/en/
SCP_INVITED_USER_PASSWORD=<set locally; never commit>

# Configure the tabs currently in automation scope.
# Add more comma-separated tab names when the scope grows.
SCP_TAB_NAMES=Procurement Log,First Delivery Inspections,International Shipments

# Optional stronger validation after opening each tab.
# Use visible text that appears on that tab, or leave empty.
SCP_TAB_ONE_EXPECTED_TEXT=
SCP_TAB_TWO_EXPECTED_TEXT=
SCP_TAB_3_EXPECTED_TEXT=

# Optional direct routes if the app supports them.
SCP_TAB_ONE_ROUTE=
SCP_TAB_TWO_ROUTE=
SCP_TAB_3_ROUTE=

# Execution mode: normal for fast runs, demo for highlighting and visible pauses.
SCP_EXECUTION_MODE=normal
SCP_TEST_EMAIL_DOMAIN=yopmail.com

# Dedicated unassigned inspection submittals for FDI mutation tests.
# Use different records: each test submits and completes its target.
SCP_FDI_SMOKE_SUBMITTAL=
SCP_FDI_REGRESSION_SUBMITTAL=

# Optional FDI acceptance-criteria fixtures (no passwords in the JSON).
SCP_FDI_ACCESS_CASES=
SCP_FDI_REASSIGN_INSPECTOR=
SCP_FDI_UNCONFIGURED_PROJECT=
SCP_FDI_SECOND_PROJECT=
# Set true only when this account is eligible for every listed Material.
SCP_FDI_CURRENT_USER_ELIGIBLE=
SCP_FDI_PHOTO_SUBMITTAL=
SCP_FDI_PHOTO_COMPLETE=false

# Dedicated accessible wizard project; mutation is opt-in and requires available slots.
SCP_WIZARD_PROJECT=
SCP_WIZARD_CREATE_DATA=false
SCP_WIZARD_UOM=
SCP_WIZARD_PHONE=

# Browser/debug tuning.
HEADLESS=false
SCP_SLOW_MO=100
SCP_ACTION_INTERVAL_MS=1000
STEP_WAIT_MS=700
SCP_MODULE_OPERATION_PAUSE_MS=1500
HIGHLIGHT_MS=500
